// =============================================
// MINION - OPTIMIZADO
// =============================================
class Minion {
    constructor(x, z, isEnemy = false, tipo = 'melee') {
        this.isEnemy = isEnemy;
        this.tipo = tipo;
        this.maxHealth = tipo === 'mage' ? 60 : 100;
        this.health = this.maxHealth;
        this.speed = 1.4;
        this.direction = isEnemy ? -1 : 1;
        this.attackDamage = tipo === 'mage' ? 15 : 10;
        this.attackRange = tipo === 'mage' ? 3.5 : 1.5;
        this.attackCooldown = 0;
        this.attackSpeed = tipo === 'mage' ? 1.5 : 1.0;
        this.isDead = false;
        this.type = 'minion';
        this.healthBarDirty = true; // Marcar para actualizar
        this.lastHealthUpdate = 0;
        this.updateInterval = 0.3; // Actualizar barra cada 0.3 segundos
        
        const scale = 0.5;
        const color = isEnemy ? 0xff5555 : 0x5588ff;
        
        this.group = new THREE.Group();
        
        // Cuerpo (simplificado para rendimiento)
        const body = new THREE.Mesh(
            new THREE.SphereGeometry(0.3 * scale, 6, 6), // Menos segmentos
            new THREE.MeshStandardMaterial({ color, roughness: 0.6 })
        );
        body.scale.set(0.9, 1.2, 0.8);
        body.position.y = 0.5 * scale;
        this.group.add(body);
        
        const head = new THREE.Mesh(
            new THREE.SphereGeometry(0.22 * scale, 6, 6), // Menos segmentos
            new THREE.MeshStandardMaterial({ color, roughness: 0.5 })
        );
        head.scale.set(1, 0.9, 0.9);
        head.position.set(0, 0.9 * scale, 0);
        this.group.add(head);
        
        // Barra de vida (simplificada)
        const barGeo = new THREE.PlaneGeometry(0.8, 0.06);
        const barMat = new THREE.MeshBasicMaterial({ color: 0x44ff44 });
        this.healthBar = new THREE.Mesh(barGeo, barMat);
        this.healthBar.position.y = 1.3 * scale;
        this.group.add(this.healthBar);
        
        // Fondo de la barra (negro)
        const bgBar = new THREE.Mesh(
            new THREE.PlaneGeometry(0.8, 0.06),
            new THREE.MeshBasicMaterial({ color: 0x000000 })
        );
        bgBar.position.y = 1.3 * scale;
        this.group.add(bgBar);
        // Mover la barra verde al frente
        this.healthBar.position.z = 0.01;
        
        this.group.rotation.y = isEnemy ? Math.PI : 0;
        this.group.position.set(x, -0.3, z);
        scene.add(this.group);
    }
    
    updateHealthBar() {
        // Solo actualizar si pasó suficiente tiempo
        const now = performance.now() / 1000;
        if (now - this.lastHealthUpdate < this.updateInterval && !this.healthBarDirty) {
            return;
        }
        this.lastHealthUpdate = now;
        this.healthBarDirty = false;
        
        const percent = this.health / this.maxHealth;
        this.healthBar.scale.x = Math.max(0, percent);
        // Cambiar color según vida
        if (percent > 0.3) {
            this.healthBar.material.color.setHex(0x44ff44);
        } else {
            this.healthBar.material.color.setHex(0xff4444);
        }
    }
    
    update(delta, enemies) {
        if (this.isDead) return;
        this.attackCooldown -= delta;
        
        let closest = null;
        let closestDist = this.attackRange + 1;
        for (const enemy of enemies) {
            if (enemy.isDead) continue;
            const dist = this.group.position.distanceTo(enemy.group.position);
            if (dist < closestDist) {
                closestDist = dist;
                closest = enemy;
            }
        }
        
        if (closest && closestDist <= this.attackRange) {
            if (this.attackCooldown <= 0) {
                closest.health -= this.attackDamage;
                closest.healthBarDirty = true;
                this.attackCooldown = this.attackSpeed;
                if (closest.health <= 0 && closest.die) {
                    closest.die();
                }
            }
        } else {
            let newZ = this.group.position.z + this.direction * this.speed * delta;
            if (newZ > 26) newZ = 26;
            if (newZ < -26) newZ = -26;
            this.group.position.z = newZ;
        }
        // Marcar para actualizar si la vida cambió
        if (this.healthBarDirty) {
            this.updateHealthBar();
        }
    }
    
    die() {
        if (this.isDead) return;
        this.isDead = true;
        this.group.visible = false;
        if (typeof addExp !== 'undefined') {
            addExp(20);
        }
    }
}

// =============================================
// TORRE (simplificada)
// =============================================
class SimpleTower {
    constructor(x, z, isEnemy = false) {
        this.isEnemy = isEnemy;
        this.maxHealth = 500;
        this.health = this.maxHealth;
        this.isDead = false;
        this.range = 6;
        this.damage = 20;
        this.fireRate = 1.5;
        this.cooldown = 0;
        this.type = 'tower';
        this.healthBarDirty = true;
        this.lastHealthUpdate = 0;
        this.updateInterval = 0.3;
        this.group = new THREE.Group();
        
        const color = isEnemy ? 0xcc4444 : 0x4488cc;
        const body = new THREE.Mesh(
            new THREE.CylinderGeometry(0.8, 1.0, 1.5, 6), // Menos segmentos
            new THREE.MeshStandardMaterial({ color, roughness: 0.5, metalness: 0.3 })
        );
        body.position.y = 0.75;
        this.group.add(body);
        
        const gem = new THREE.Mesh(
            new THREE.OctahedronGeometry(0.2),
            new THREE.MeshStandardMaterial({
                color: isEnemy ? 0xff4444 : 0x4488ff,
                emissive: isEnemy ? 0xff4444 : 0x4488ff,
                emissiveIntensity: 1.0
            })
        );
        gem.position.y = 1.6;
        this.group.add(gem);
        this.gem = gem;
        
        const barGeo = new THREE.PlaneGeometry(1.2, 0.06);
        const barMat = new THREE.MeshBasicMaterial({ color: 0x44ff44 });
        this.healthBar = new THREE.Mesh(barGeo, barMat);
        this.healthBar.position.y = 2.2;
        this.group.add(this.healthBar);
        
        // Fondo de barra
        const bgBar = new THREE.Mesh(
            new THREE.PlaneGeometry(1.2, 0.06),
            new THREE.MeshBasicMaterial({ color: 0x000000 })
        );
        bgBar.position.y = 2.2;
        this.group.add(bgBar);
        this.healthBar.position.z = 0.01;
        
        this.group.position.set(x, -0.3, z);
        scene.add(this.group);
    }
    
    updateHealthBar() {
        const now = performance.now() / 1000;
        if (now - this.lastHealthUpdate < this.updateInterval && !this.healthBarDirty) {
            return;
        }
        this.lastHealthUpdate = now;
        this.healthBarDirty = false;
        
        const percent = this.health / this.maxHealth;
        this.healthBar.scale.x = Math.max(0, percent);
        this.healthBar.material.color.setHex(percent > 0.3 ? 0x44ff44 : 0xff4444);
    }
    
    takeDamage(damage) {
        if (this.isDead) return;
        this.health -= damage;
        this.healthBarDirty = true;
        this.updateHealthBar();
        if (this.health <= 0) {
            this.health = 0;
            this.isDead = true;
            this.group.visible = false;
        }
    }
}

