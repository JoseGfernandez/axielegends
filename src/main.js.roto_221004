    }
    
    updateHealthBar() {
        const now = performance.now() / 1000;
        if (now - this.lastHealthUpdate < this.updateInterval && !this.healthBarDirty) {
            return;
        }
        this.lastHealthUpdate = now;
        this.healthBarDirty = false;
        
        const percent = this.health / this.maxHealth;
        this.healthBar.scale.x = Math.max(0, percent);
        this.healthBar.material.color.setHex(percent > 0.3 ? 0x44ff44 : 0xff4444);
    }
    
    takeDamage(damage) {
        if (this.isDead) return;
        this.health -= damage;
        this.healthBarDirty = true;
        this.updateHealthBar();
        if (this.health <= 0) {
            this.health = 0;
            this.isDead = true;
            this.group.visible = false;
        }
    }
}

// Crear torres y nexos
const nexusAliado = new SimpleNexus(0, -26, false);
const nexusEnemigo = new SimpleNexus(0, 26, true);

const towers = [];
const towerPositions = [
    [-3.5, -18, false],
    [-3.5, -6, false],
    [3.5, 18, true],
    [3.5, 6, true]
];
for (const [x, z, isEnemy] of towerPositions) {
    towers.push(new SimpleTower(x, z, isEnemy));
}

// =============================================
// SISTEMA DE OLEADAS - OPTIMIZADO
// =============================================
const aliados = [];
const enemigos = [];
let waveNumber = 1;
let waveCooldown = 0;
const WAVE_DELAY = 1.5;
let gameStarted = false;
let startTimer = CONFIG.SPAWN_DELAY;

function spawnWave() {
    // Limpiar minions muertos
    for (let i = aliados.length - 1; i >= 0; i--) {
        if (aliados[i].isDead) {
            scene.remove(aliados[i].group);
            aliados.splice(i, 1);
        }
    }
    for (let i = enemigos.length - 1; i >= 0; i--) {
        if (enemigos[i].isDead) {
            scene.remove(enemigos[i].group);
            enemigos.splice(i, 1);
        }
    }
    
    // Menos minions por oleada para mejor rendimiento
    const maxPerWave = CONFIG.MAX_MINIONS_PER_WAVE;
    const meleeCount = Math.min(waveNumber === 1 ? 4 : 2, maxPerWave - 1);
    const mageCount = Math.min(waveNumber === 1 ? 2 : 1, maxPerWave - meleeCount);
    
    console.log('⚔️ OLEADA ' + waveNumber + ': ' + meleeCount + ' Melee + ' + mageCount + ' Mage');
    const waveDiv = document.getElementById('wave-display');
    if (waveDiv) waveDiv.textContent = '⚔️ OLEADA ' + waveNumber;
    
    const spacing = 1.1;
    const mageSpacing = 0.9;
    const totalMelee = (meleeCount - 1) * spacing;
    const totalMage = (mageCount - 1) * mageSpacing;
    
    // Aliados
    for (let i = 0; i < meleeCount; i++) {
        const x = -totalMelee / 2 + i * spacing;
        const z = -18 - i * 0.3;
        aliados.push(new Minion(x, z, false, 'melee'));
    }
    for (let i = 0; i < mageCount; i++) {
        const x = -totalMage / 2 + i * mageSpacing;
        const z = -18 - meleeCount * 0.3 - 1.0 - i * 0.2;
        aliados.push(new Minion(x, z, false, 'mage'));
    }
    
    // Enemigos (espejo)
    for (let i = 0; i < meleeCount; i++) {
        const x = -totalMelee / 2 + i * spacing;
        const z = 18 + i * 0.3;
        enemigos.push(new Minion(x, z, true, 'melee'));
    }
    for (let i = 0; i < mageCount; i++) {
        const x = -totalMage / 2 + i * mageSpacing;
        const z = 18 + meleeCount * 0.3 + 1.0 + i * 0.2;
        enemigos.push(new Minion(x, z, true, 'mage'));
    }
    
    waveNumber++;
    waveCooldown = 0;
}

