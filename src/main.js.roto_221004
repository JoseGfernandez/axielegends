// =============================================
// JUGADOR - AXIE 3D
// =============================================
let playerModel = null;
let mixer = null;
let animIdle = null;
let animWalk = null;
let currentAnim = 'idle';

let targetPosition = null;
let isMovingToTarget = false;
let playerSpeed = CONFIG.axieSpeed;
const playerSpawnPosition = new THREE.Vector3(0, 0, -20);
let smoothPlayerPos = new THREE.Vector3(0, 0, -20);

let isDragging = false;
let isMouseDown = false;
let mouseDownPos = { x: 0, y: 0 };

const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();

// ===== CARGAR AXIE 3D =====
console.log('📦 Cargando Axie del jugador...');

const loader = new GLTFLoader();
loader.load(
    '/axie-3d-assets/assets/mascots/bing.glb',
    function(gltf) {
        console.log('✅ Axie del jugador cargado!');
        playerModel = gltf.scene;
        playerModel.scale.set(1.2, 1.2, 1.2);
        playerModel.position.copy(playerSpawnPosition);
        smoothPlayerPos.copy(playerSpawnPosition);
        playerModel.castShadow = true;
        playerModel.traverse(function(node) {
            if (node.isMesh) {
                node.castShadow = true;
                node.receiveShadow = true;
            }
        });
        scene.add(playerModel);
        
        mixer = new THREE.AnimationMixer(playerModel);
        const clips = gltf.animations;
        clips.forEach(function(clip) {
            const name = clip.name.toLowerCase();
            if (name.includes('idle')) animIdle = mixer.clipAction(clip);
            if (name.includes('walk')) animWalk = mixer.clipAction(clip);
        });
        if (animIdle) animIdle.play();
        console.log('🎬 Animaciones del jugador cargadas');
    },
    undefined,
    function(error) {
        console.error('❌ Error cargando Axie del jugador:', error);
        const fallback = new THREE.Mesh(
            new THREE.BoxGeometry(0.8, 1.2, 0.8),
            new THREE.MeshStandardMaterial({ color: 0xff4444, emissive: 0xff2222, emissiveIntensity: 0.2 })
        );
        fallback.position.copy(playerSpawnPosition);
        scene.add(fallback);
        playerModel = fallback;
        smoothPlayerPos.copy(playerSpawnPosition);
        console.log('📌 Usando Axie de respaldo (cubo rojo)');
    }
);

// =============================================
// FUNCIONES DEL MOUSE
// =============================================
function getGroundIntersection(event) {
    const rect = renderer.domElement.getBoundingClientRect();
    mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
    raycaster.setFromCamera(mouse, camera);
    const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
    const point = new THREE.Vector3();
    const intersectPoint = raycaster.ray.intersectPlane(plane, point);
    if (intersectPoint) {
        intersectPoint.x = Math.max(-17, Math.min(17, intersectPoint.x));
        intersectPoint.z = Math.max(-27, Math.min(27, intersectPoint.z));
        return intersectPoint;
    }
    return null;
}

function getTargetFromClick(event) {
    const rect = renderer.domElement.getBoundingClientRect();
    mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
    raycaster.setFromCamera(mouse, camera);
    
    // Buscar objetos seleccionables (minions, torres, nexos)
    const selectables = [];
    const allGroups = [aliados, enemigos, towers, [nexusAliado, nexusEnemigo]];
    for (const list of allGroups) {
        for (const item of list) {
            if (item.group && item.group.visible) {
                item.group.traverse(function(child) {
                    if (child.isMesh) {
                        selectables.push(child);
                    }
                });
            }
        }
    }
    
    const intersects = raycaster.intersectObjects(selectables);
    if (intersects.length > 0) {
        // Encontrar el objeto padre
        let obj = intersects[0].object;
        // Buscar en la jerarquía el grupo que contiene el objeto
        let parent = obj.parent;
        while (parent) {
            // Verificar si este grupo pertenece a algún objeto de juego
            for (const list of allGroups) {
                for (const item of list) {
                    if (item.group === parent) {
                        return item;
                    }
                }
            }
            parent = parent.parent;
        }
    }
    return null;
}

// ===== EVENTOS DEL MOUSE =====
renderer.domElement.addEventListener('mousedown', function(e) {
    if (e.button === 0) {
        isMouseDown = true;
        isDragging = false;
        mouseDownPos.x = e.clientX;
        mouseDownPos.y = e.clientY;
        
        if (playerModel) {
            const target = getTargetFromClick(e);
            if (target) {
                console.log('🎯 Seleccionado:', target.type || 'objeto');
                // Aquí puedes añadir lógica de ataque
                return;
            }
        }
    }
});

renderer.domElement.addEventListener('mousemove', function(e) {
    if (isMouseDown) {
        var dx = e.clientX - mouseDownPos.x;
        var dy = e.clientY - mouseDownPos.y;
        if (Math.abs(dx) > 8 || Math.abs(dy) > 8) isDragging = true;
    }
});

renderer.domElement.addEventListener('mouseup', function(e) {
    if (e.button === 0) {
        if (!isDragging && playerModel) {
            var point = getGroundIntersection(e);
            if (point) {
                targetPosition = point.clone();
                isMovingToTarget = true;
            }
        }
        isMouseDown = false;
        isDragging = false;
    }
});

renderer.domElement.addEventListener('contextmenu', function(e) { e.preventDefault(); });

// =============================================
// VISOR DE MEMORIA
// =============================================
const memoryDiv = document.createElement('div');
memoryDiv.id = 'memory-display';
memoryDiv.style.cssText = `
    position: fixed;
    top: 46px;
    right: 20px;
    color: #44ff88;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    font-weight: bold;
    background: rgba(0, 0, 0, 0.75);
    padding: 3px 10px;
    border-radius: 6px;
    z-index: 100;
    pointer-events: none;
    border: 1px solid rgba(68, 255, 136, 0.2);
    min-width: 130px;
    text-align: right;
    line-height: 1.4;
    transition: all 0.3s ease;
`;
memoryDiv.textContent = '🧠 Memoria: 0 MB (0%)';
document.body.appendChild(memoryDiv);

function getMemoryStatus() {
    try {
        if (window.performance && window.performance.memory) {
            const mem = window.performance.memory;
            const usedMB = (mem.usedJSHeapSize / 1048576).toFixed(1);
            const totalMB = (mem.jsHeapSizeLimit / 1048576).toFixed(0);
            const percent = ((mem.usedJSHeapSize / mem.jsHeapSizeLimit) * 100).toFixed(1);
            return { used: usedMB, total: totalMB, percent: percent };
        } else if (typeof scene !== 'undefined' && scene.children) {
            const total = scene.children.length;
            return { used: (total * 0.3).toFixed(1), total: 'N/A', percent: 'N/A' };
        }
        return { used: '?', total: '?', percent: '?' };
    } catch (e) {
        return { used: '?', total: '?', percent: '?' };
    }
}

function updateMemoryDisplay() {
    const status = getMemoryStatus();
    let displayText = '';
    let color = '#44ff88';
    let borderColor = 'rgba(68, 255, 136, 0.2)';
    
    if (status.percent !== 'N/A' && status.percent !== '?') {
        const p = parseFloat(status.percent);
        if (p > 85) {
            color = '#ff4444';
            borderColor = 'rgba(255, 68, 68, 0.4)';
            memoryDiv.style.boxShadow = '0 0 25px rgba(255, 68, 68, 0.3)';
        } else if (p > 70) {
            color = '#ffaa44';
            borderColor = 'rgba(255, 170, 68, 0.3)';
            memoryDiv.style.boxShadow = '0 0 15px rgba(255, 170, 68, 0.2)';
        } else {
            color = '#44ff88';
            borderColor = 'rgba(68, 255, 136, 0.2)';
            memoryDiv.style.boxShadow = 'none';
        }
        displayText = `🧠 ${status.used} MB / ${status.total} MB (${status.percent}%)`;
        memoryDiv.style.color = color;
        memoryDiv.style.borderColor = borderColor;
        if (p > 90) {
            displayText = '⚠️ ' + displayText;
        }
    } else if (status.used !== '?') {
        displayText = `🧠 ${status.used} MB (estimado)`;
        memoryDiv.style.color = '#88aaff';
    } else {
        displayText = '🧠 Memoria: N/A';
        memoryDiv.style.color = '#88aaff';
    }
    memoryDiv.textContent = displayText;
}

setInterval(updateMemoryDisplay, 2000);
setTimeout(updateMemoryDisplay, 500);

window.memory = {
    getStatus: getMemoryStatus,
    update: updateMemoryDisplay
};

console.log('🧠 Visor de memoria activado');

// =============================================
// OCULTAR CARGA
// =============================================
function hideLoading() {
    var loading = document.getElementById('loading');
    if (loading) {
        loading.style.opacity = '0';
        setTimeout(function() {
            loading.style.display = 'none';
        }, 500);
    }
}

// =============================================
// LOOP PRINCIPAL
// =============================================
var frameCounter = 0;
var lastTime = 0;
var gameTime = 0;
var realFPS = 0;
var fpsCounter = 0;
var fpsTimer = 0;

function gameLoop(time) {
    var delta = Math.min((time - lastTime) / 1000, 0.05);
    lastTime = time;
    frameCounter++;
    gameTime += delta;
    
    timerDiv.textContent = Math.floor(gameTime / 60).toString().padStart(2, '0') + ':' + Math.floor(gameTime % 60).toString().padStart(2, '0');
    
    fpsCounter++;
    fpsTimer += delta;
    if (fpsTimer >= 1.0) {
        realFPS = Math.round(fpsCounter / fpsTimer);
        fpsCounter = 0;
        fpsTimer = 0;
        fpsDiv.textContent = 'FPS: ' + realFPS;
    }
    
    // ===== MOVIMIENTO =====
    if (playerModel) {
        if (isMovingToTarget && targetPosition) {
            var dx = targetPosition.x - smoothPlayerPos.x;
            var dz = targetPosition.z - smoothPlayerPos.z;
            var dist = Math.sqrt(dx * dx + dz * dz);
            
            if (dist < 0.05) {
                smoothPlayerPos.copy(targetPosition);
                isMovingToTarget = false;
                targetPosition = null;
            } else {
                var moveSpeed = playerSpeed * delta;
                var stepX = (dx / dist) * moveSpeed;
                var stepZ = (dz / dist) * moveSpeed;
                if (Math.abs(stepX) > Math.abs(dx)) smoothPlayerPos.x = targetPosition.x;
                else smoothPlayerPos.x += stepX;
                if (Math.abs(stepZ) > Math.abs(dz)) smoothPlayerPos.z = targetPosition.z;
                else smoothPlayerPos.z += stepZ;
                
                var angle = Math.atan2(dx, dz);
                playerModel.rotation.y = angle;
            }
            playerModel.position.copy(smoothPlayerPos);
        } else if (smoothPlayerPos) {
            playerModel.position.copy(smoothPlayerPos);
        }
    }
    
    // ===== JUEGO =====
    if (!gameStarted) {
        startTimer -= delta;
        waveDiv.textContent = '⏳ ' + Math.ceil(startTimer) + 's';
        if (startTimer <= 0) {
            gameStarted = true;
            spawnWave();
        }
        if (playerModel) updateCameraPosition();
        renderer.render(scene, camera);
        requestAnimationFrame(gameLoop);
        return;
    }
    
    // Actualizar torres
    for (var i = 0; i < towers.length; i++) {
        var tower = towers[i];
        if (tower.isDead) continue;
        tower.cooldown -= delta;
        var enemiesTarget = tower.isEnemy ? aliados : enemigos;
        var closest = null;
        var closestDist = tower.range + 1;
        for (var j = 0; j < enemiesTarget.length; j++) {
            var enemy = enemiesTarget[j];
            if (enemy.isDead) continue;
            var dist = tower.group.position.distanceTo(enemy.group.position);
            if (dist < closestDist && dist <= tower.range) {
                closestDist = dist;
                closest = enemy;
            }
        }
        if (closest && tower.cooldown <= 0) {
            closest.health -= tower.damage;
            closest.healthBarDirty = true;
            tower.cooldown = tower.fireRate;
            if (closest.health <= 0 && closest.die) closest.die();
        }
    }
    
    // Actualizar minions (menos frecuente)
    if (frameCounter % 2 === 0) {
        for (var k = 0; k < aliados.length; k++) {
            aliados[k].update(delta, enemigos);
        }
        for (var m = 0; m < enemigos.length; m++) {
            enemigos[m].update(delta, aliados);
        }
    }
    
    // Actualizar barras de vida (solo si es necesario)
    if (frameCounter % CONFIG.UPDATE_INTERVAL === 0) {
        for (const minion of aliados) {
            if (minion.healthBarDirty) minion.updateHealthBar();
        }
        for (const minion of enemigos) {
            if (minion.healthBarDirty) minion.updateHealthBar();
        }
        for (const tower of towers) {
            if (tower.healthBarDirty) tower.updateHealthBar();
        }
        if (nexusAliado.healthBarDirty) nexusAliado.updateHealthBar();
        if (nexusEnemigo.healthBarDirty) nexusEnemigo.updateHealthBar();
    }
    
    // Verificar oleadas
    var aliveAliados = aliados.filter(function(m) { return !m.isDead; });
    var aliveEnemigos = enemigos.filter(function(m) { return !m.isDead; });
    if (aliveAliados.length === 0 || aliveEnemigos.length === 0) {
        waveCooldown += delta;
        if (waveCooldown > WAVE_DELAY) {
            waveCooldown = 0;
            spawnWave();
        }
    } else {
        waveCooldown = 0;
    }
    
    // Actualizar animaciones
    if (mixer) {
        var isMoving = isMovingToTarget;
        var targetAnim = isMoving ? 'walk' : 'idle';
        if (targetAnim !== currentAnim) {
            if (currentAnim === 'idle' && animIdle) animIdle.stop();
            if (currentAnim === 'walk' && animWalk) animWalk.stop();
            if (targetAnim === 'idle' && animIdle) animIdle.play();
            if (targetAnim === 'walk' && animWalk) animWalk.play();
            currentAnim = targetAnim;
        }
        mixer.update(delta);
    }
    
    if (playerModel) updateCameraPosition();
    renderer.render(scene, camera);
    requestAnimationFrame(gameLoop);
}

// =============================================
// REDIMENSIONAR
// =============================================
window.addEventListener('resize', function() {
    var aspect = window.innerWidth / window.innerHeight;
    camera.left = -7.2 * aspect;
    camera.right = 7.2 * aspect;
    camera.top = 7.2;
    camera.bottom = -7.2;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});

