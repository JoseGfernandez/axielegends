            this.group.add(swordGroup);
        }
        
        const legGeo = new THREE.CylinderGeometry(0.06 * scale, 0.08 * scale, 0.15 * scale, 6);
        const legMat = new THREE.MeshStandardMaterial({ color: darkColor, roughness: 0.7 });
