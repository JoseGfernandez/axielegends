// =============================================
// OCULTAR CARGA
// =============================================
function hideLoading() {
    const loading = document.getElementById('loading');
    if (loading) {
        loading.style.opacity = '0';
        setTimeout(() => {
            loading.style.display = 'none';
        }, 500);
    }
}

// =============================================
// LOOP PRINCIPAL
// =============================================
let frameCounter = 0;
let lastTime = 0;
let gameTime = 0;
let realFPS = 0;
let fpsCounter = 0;
let fpsTimer = 0;

function gameLoop(time) {
    const delta = Math.min((time - lastTime) / 1000, 0.05);
    lastTime = time;
    frameCounter++;
    gameTime += delta;
    
    timerDiv.textContent = `${Math.floor(gameTime / 60).toString().padStart(2, '0')}:${Math.floor(gameTime % 60).toString().padStart(2, '0')}`;
    
    fpsCounter++;
    fpsTimer += delta;
    if (fpsTimer >= 1.0) {
        realFPS = Math.round(fpsCounter / fpsTimer);
        fpsCounter = 0;
        fpsTimer = 0;
        fpsDiv.textContent = `FPS: ${realFPS}`;
    }
    
    // ===== MOVIMIENTO =====
    if (playerModel) {
        if (isMovingToTarget && targetPosition) {
            const dx = targetPosition.x - smoothPlayerPos.x;
            const dz = targetPosition.z - smoothPlayerPos.z;
            const dist = Math.sqrt(dx*dx + dz*dz);
            
            if (dist < 0.05) {
                smoothPlayerPos.copy(targetPosition);
                isMovingToTarget = false;
                targetPosition = null;
            } else {
                const moveSpeed = playerSpeed * delta;
                const stepX = (dx / dist) * moveSpeed;
                const stepZ = (dz / dist) * moveSpeed;
                if (Math.abs(stepX) > Math.abs(dx)) smoothPlayerPos.x = targetPosition.x;
                else smoothPlayerPos.x += stepX;
                if (Math.abs(stepZ) > Math.abs(dz)) smoothPlayerPos.z = targetPosition.z;
                else smoothPlayerPos.z += stepZ;
                
                const angle = Math.atan2(dx, dz);
                playerModel.rotation.y = angle;
            }
            playerModel.position.copy(smoothPlayerPos);
        } else if (smoothPlayerPos) {
            playerModel.position.copy(smoothPlayerPos);
        }
    }
    
    // ===== JUEGO =====
    if (!gameStarted) {
        startTimer -= delta;
        waveDiv.textContent = `⏳ ${Math.ceil(startTimer)}s`;
        if (startTimer <= 0) {
            gameStarted = true;
            spawnWave();
        }
        if (playerModel) updateCameraPosition();
        renderer.render(scene, camera);
        requestAnimationFrame(gameLoop);
        return;
    }
    
    // Actualizar torres
    for (const tower of towers) {
        if (tower.isDead) continue;
        tower.cooldown -= delta;
        const enemiesTarget = tower.isEnemy ? aliados : enemigos;
        let closest = null;
        let closestDist = tower.range + 1;
        for (const enemy of enemiesTarget) {
            if (enemy.isDead) continue;
            const dist = tower.group.position.distanceTo(enemy.group.position);
            if (dist < closestDist && dist <= tower.range) {
                closestDist = dist;
                closest = enemy;
            }
        }
        if (closest && tower.cooldown <= 0) {
            closest.health -= tower.damage;
            closest.updateHealthBar();
            tower.cooldown = tower.fireRate;
            if (closest.health <= 0 && closest.die) closest.die();
        }
    }
    
    // Actualizar minions
    if (frameCounter % 2 === 0) {
        for (const m of aliados) {
            m.update(delta, enemigos);
        }
        for (const m of enemigos) {
            m.update(delta, aliados);
        }
    }
    
    // Verificar oleadas
    const aliveAliados = aliados.filter(m => !m.isDead);
    const aliveEnemigos = enemigos.filter(m => !m.isDead);
    if (aliveAliados.length === 0 || aliveEnemigos.length === 0) {
        waveCooldown += delta;
        if (waveCooldown > WAVE_DELAY) {
            waveCooldown = 0;
            spawnWave();
        }
    } else {
        waveCooldown = 0;
    }
    
    // Actualizar habilidades (cooldowns)
    for (const key in skillData) {
        if (skillData[key].cooldown > 0) {
            skillData[key].cooldown -= delta;
            if (skillData[key].cooldown < 0) skillData[key].cooldown = 0;
        }
    }
    
    if (playerModel) updateCameraPosition();
    renderer.render(scene, camera);
    requestAnimationFrame(gameLoop);
}

// =============================================
window.addEventListener('resize', () => {
    const aspect = window.innerWidth / window.innerHeight;
    camera.left = -7.2 * aspect;
    camera.right = 7.2 * aspect;
    camera.top = 7.2;
    camera.bottom = -7.2;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});

