// =============================================
// DATOS DEL AXIE PARA EL HUB
// =============================================
const axieData = {
    name: 'Puff',
    level: 1,
    maxHealth: 500,
    health: 500,
    maxEnergy: 100,
    energy: 100,
    attack: 20,
    defense: 10,
    speed: 1.5,
    items: [null, null, null, null, null, null],
    exp: 0,
    expToNext: 100,
};

// =============================================
// FUNCIONES DEL HUB
// =============================================
function updateHub() {
    const healthPercent = (axieData.health / axieData.maxHealth) * 100;
    const energyPercent = (axieData.energy / axieData.maxEnergy) * 100;
    
    const healthBar = document.getElementById('health-bar');
    const energyBar = document.getElementById('energy-bar');
    const healthLabel = document.getElementById('health-label');
    const energyLabel = document.getElementById('energy-label');
    
    if (healthBar) healthBar.style.width = `${Math.max(0, healthPercent)}%`;
    if (energyBar) energyBar.style.width = `${Math.max(0, energyPercent)}%`;
    if (healthLabel) healthLabel.textContent = `❤️ ${Math.floor(axieData.health)} / ${axieData.maxHealth}`;
    if (energyLabel) energyLabel.textContent = `🔵 ${Math.floor(axieData.energy)} / ${axieData.maxEnergy}`;
    
    const attackEl = document.getElementById('stat-attack');
    const defenseEl = document.getElementById('stat-defense');
    const speedEl = document.getElementById('stat-speed');
    if (attackEl) attackEl.textContent = axieData.attack;
    if (defenseEl) defenseEl.textContent = axieData.defense;
    if (speedEl) speedEl.textContent = axieData.speed.toFixed(1);
    
    const levelEl = document.querySelector('#axie-name .level');
    if (levelEl) levelEl.textContent = `Nv. ${axieData.level}`;
    
    const expFill = document.getElementById('exp-fill');
    if (expFill) {
        const percent = (axieData.exp / axieData.expToNext) * 100;
        expFill.style.width = `${Math.min(100, percent)}%`;
    }
    
    const slots = document.querySelectorAll('#axie-items .item-slot');
    slots.forEach((slot, index) => {
        const item = axieData.items[index];
        const icon = slot.querySelector('.item-icon');
        if (item) {
            slot.classList.add('has-item');
            if (icon) icon.textContent = item.icon || '🟦';
        } else {
            slot.classList.remove('has-item');
            if (icon) icon.textContent = '⬜';
        }
    });
}

// =============================================
// SISTEMA DE HABILIDADES
// =============================================
const skillData = {
    q: { name: 'Garra Salvaje', level: 1, maxLevel: 5, cooldown: 0, maxCooldown: 4, damage: 25 },
    w: { name: 'Rugido', level: 1, maxLevel: 5, cooldown: 0, maxCooldown: 6, damage: 0 },
    e: { name: 'Escudo', level: 1, maxLevel: 5, cooldown: 0, maxCooldown: 8, damage: 0 },
    r: { name: 'Furia Bestial', level: 1, maxLevel: 3, cooldown: 0, maxCooldown: 12, damage: 50 },
};

let skillPoints = 1;

function useSkill(skillKey) {
    const skill = skillData[skillKey];
    if (!skill) return;
    if (skill.cooldown > 0) {
        console.log(`⏳ ${skill.name} en cooldown (${Math.ceil(skill.cooldown)}s)`);
        return;
    }
    console.log(`⚡ Usando ${skill.name} (Nv. ${skill.level})`);
    
    if (skillKey === 'q') {
        const damage = skill.damage + (skill.level - 1) * 5;
        let hitCount = 0;
        if (typeof enemigos !== 'undefined') {
            for (const enemy of enemigos) {
                if (enemy.isDead) continue;
                if (playerModel) {
                    const dist = playerModel.position.distanceTo(enemy.group.position);
                    if (dist < 5) {
                        enemy.health -= damage;
                        enemy.updateHealthBar();
                        if (enemy.health <= 0) enemy.die();
                        hitCount++;
                    }
                }
            }
        }
        console.log(`💥 Daño ${damage} a ${hitCount} enemigos`);
    } else if (skillKey === 'w') {
        const boost = 5 + (skill.level - 1) * 3;
        axieData.attack += boost;
        console.log(`🐻 Ataque +${boost} (${axieData.attack})`);
        setTimeout(() => {
            axieData.attack -= boost;
            updateHub();
        }, 5000);
    } else if (skillKey === 'e') {
        const heal = 30 + (skill.level - 1) * 20;
        axieData.health = Math.min(axieData.maxHealth, axieData.health + heal);
        console.log(`🛡️ +${heal} HP (${axieData.health}/${axieData.maxHealth})`);
    } else if (skillKey === 'r') {
        const damage = skill.damage + (skill.level - 1) * 25;
        let hitCount = 0;
        if (typeof enemigos !== 'undefined') {
            for (const enemy of enemigos) {
                if (enemy.isDead) continue;
                if (playerModel) {
                    const dist = playerModel.position.distanceTo(enemy.group.position);
                    if (dist < 6) {
                        enemy.health -= damage;
                        enemy.updateHealthBar();
                        if (enemy.health <= 0) enemy.die();
                        hitCount++;
                    }
                }
            }
        }
        console.log(`🔥 DEFINITIVA! ${damage} daño a ${hitCount} enemigos`);
    }
    
    skill.cooldown = skill.maxCooldown;
    updateHub();
}

function levelUpSkill(skillKey) {
    const skill = skillData[skillKey];
    if (!skill) return;
    if (skillPoints <= 0) { console.log('❌ Sin puntos'); return; }
    if (skill.level >= skill.maxLevel) { console.log(`❌ ${skill.name} al máximo`); return; }
    skill.level++;
    skillPoints--;
    console.log(`✅ ${skill.name} → Nv. ${skill.level}`);
    updateHub();
    const nameEl = document.querySelector('#axie-name .name');
    if (nameEl && skillPoints > 0) {
        nameEl.textContent = `⚔️ Puff ✨+${skillPoints}`;
    } else if (nameEl) {
        nameEl.textContent = '⚔️ Puff';
    }
}

function addExp(amount) {
    axieData.exp += amount;
    while (axieData.exp >= axieData.expToNext) {
        axieData.exp -= axieData.expToNext;
        axieData.level++;
        axieData.expToNext = Math.floor(axieData.expToNext * 1.3) + 50;
        axieData.maxHealth += 30;
        axieData.health = Math.min(axieData.health + 30, axieData.maxHealth);
        axieData.attack += 2;
        axieData.defense += 1;
        skillPoints++;
        console.log(`🎉 Nv. ${axieData.level}! Puntos: ${skillPoints}`);
    }
    updateHub();
}

// =============================================
// EVENTOS DE TECLADO Y CLICK
// =============================================
document.addEventListener('keydown', (e) => {
    const key = e.key.toLowerCase();
    if (['q', 'w', 'e', 'r'].includes(key)) {
        useSkill(key);
        e.preventDefault();
    }
});

// Inicializar HUB
setTimeout(() => {
    updateHub();
    const nameEl = document.querySelector('#axie-name .name');
    if (nameEl && skillPoints > 0) {
        nameEl.textContent = `⚔️ Puff ✨+${skillPoints}`;
    }
    console.log('✅ HUB iniciado');
}, 100);

document.querySelectorAll('#axie-skills .skill-slot').forEach(slot => {
    slot.addEventListener('click', () => {
        levelUpSkill(slot.dataset.skill);
    });
});

