class SimpleNexus {
    constructor(x, z, isEnemy = false) {
        this.isEnemy = isEnemy;
        this.maxHealth = 1000;
        this.health = this.maxHealth;
        this.isDead = false;
        this.type = 'nexus';
        this.group = new THREE.Group();
        
        const color = isEnemy ? 0x882222 : 0x224488;
        const base = new THREE.Mesh(
            new THREE.CylinderGeometry(3, 3.5, 0.5, 24),
            new THREE.MeshStandardMaterial({ color, roughness: 0.3, metalness: 0.5 })
        );
        base.position.y = 0;
        this.group.add(base);
        
        const nexus = new THREE.Mesh(
            new THREE.SphereGeometry(1.5, 24, 24),
            new THREE.MeshStandardMaterial({
                color: isEnemy ? 0xff4444 : 0x4488ff,
                emissive: isEnemy ? 0xff4444 : 0x4488ff,
                emissiveIntensity: 0.8,
                transparent: true,
                opacity: 0.85
            })
        );
        nexus.position.y = 1.5;
        this.group.add(nexus);
        
        const barGeo = new THREE.PlaneGeometry(2.5, 0.1);
        const barMat = new THREE.MeshBasicMaterial({ color: 0x44ff44 });
        this.healthBar = new THREE.Mesh(barGeo, barMat);
        this.healthBar.position.y = 2.8;
        this.group.add(this.healthBar);
        
        this.group.position.set(x, -0.3, z);
        scene.add(this.group);
    }
    
    updateHealthBar() {
        const percent = this.health / this.maxHealth;
        this.healthBar.scale.x = Math.max(0, percent);
        this.healthBar.material.color.setHex(percent > 0.3 ? 0x44ff44 : 0xff4444);
    }
    
    takeDamage(damage) {
        if (this.isDead) return;
        this.health -= damage;
        this.updateHealthBar();
        if (this.health <= 0) {
            this.health = 0;
            this.isDead = true;
            this.group.visible = false;
        }
    }
}

// Crear torres y nexos
const nexusAliado = new SimpleNexus(0, -26, false);
const nexusEnemigo = new SimpleNexus(0, 26, true);

const towers = [];
const towerPositions = [
    [-3.5, -18, false],
    [-3.5, -6, false],
    [3.5, 18, true],
    [3.5, 6, true]
];
for (const [x, z, isEnemy] of towerPositions) {
